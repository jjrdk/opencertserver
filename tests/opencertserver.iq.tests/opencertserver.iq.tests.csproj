<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- The suite runs for each solution target framework; image publish outputs and build contexts
             are isolated by TFM so each test host exercises the matching runtime. -->
        <IsPackable>false</IsPackable>
        <RootNamespace>OpenCertServer.Iq.Tests</RootNamespace>
        <OutputType>exe</OutputType>
        <!-- Installation-qualification scenarios are orchestration + black-box HTTP/TLS
             clients (a Linux container); they are not AOT/trim targets. -->
        <IsTrimmable>false</IsTrimmable>
        <IsAotCompatible>false</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <!-- BDD runner, identical to the other Reqnroll/xunit.v3 test projects. -->
        <PackageReference Include="Reqnroll.xUnit.v3"/>
        <PackageReference Include="xunit.v3.mtp-v2"/>
        <!-- TestContainers is the substrate for the black-box execution: the
             scenarios drive a running hardened OpenCertServer that TestContainers
             starts as (a) a server image and (b) a Linux client image that runs the
             standard apt tools (see Support/IqAcmeEnvironment.cs). -->
        <PackageReference Include="Testcontainers"/>
        <!-- Docker.DotNet.Enhanced is the native Docker Engine client Testcontainers drives. We
             inspect images and containers through it (not the docker CLI, whose inspect is
             unreliable under the MTP/Docker-Desktop test host) to read the unprivileged user. -->
        <PackageReference Include="Docker.DotNet.Enhanced"/>
        <!-- Relational backends: the appliance DB scenarios boot a PostgreSQL/MSSQL container via
             TestContainers and query it directly (Npgsql / Microsoft.Data.SqlClient) to prove the
             appliance connected to and persisted data. -->
        <PackageReference Include="Testcontainers.MsSql"/>
        <PackageReference Include="Testcontainers.PostgreSql"/>
        <PackageReference Include="Npgsql"/>
        <PackageReference Include="Microsoft.Data.SqlClient"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer"/>
        <ProjectReference Include="../../build/opencertserver.build/opencertserver.build.csproj"/>
        <ProjectReference Include="../../src/opencertserver.data/opencertserver.data.csproj"/>
        <ProjectReference Include="../../src/opencertserver.data.postgresql/opencertserver.data.postgresql.csproj"/>
        <ProjectReference Include="../../src/opencertserver.data.mssql/opencertserver.data.mssql.csproj"/>
        <Compile Include="../Shared/RelationalTestDatabase.cs" Link="Support/RelationalTestDatabase.cs"/>
    </ItemGroup>

</Project>
