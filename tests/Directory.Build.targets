<Project>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'opencertserver.certserver.tests' Or
                        '$(MSBuildProjectName)' == 'opencertserver.data.tests' Or
                        '$(MSBuildProjectName)' == 'opencertserver.scep.server.tests' Or
                        '$(MSBuildProjectName)' == 'opencertserver.tpm.tests'">
