<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <RootNamespace>OpenCertServer.Contrib.Intune.Tests</RootNamespace>
        <OutputType>exe</OutputType>
        <!-- Tests are not shipped; the fake serializes anonymous objects. -->
        <IsTrimmable>false</IsTrimmable>
        <IsAotCompatible>false</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.TestHost"/>
        <PackageReference Include="Reqnroll.xUnit.v3"/>
        <PackageReference Include="xunit.v3.mtp-v2"/>
        <PackageReference Include="System.Security.Cryptography.Pkcs"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\opencertserver.ca.server\opencertserver.ca.server.csproj"/>
        <ProjectReference Include="..\..\src\opencertserver.ca.utils\opencertserver.ca.utils.csproj"/>
        <ProjectReference Include="..\..\src\opencertserver.scep.server\opencertserver.scep.server.csproj"/>
        <ProjectReference Include="..\..\src\opencertserver.contrib.intune\opencertserver.contrib.intune.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!-- The SCEP test client lives in the SCEP server tests; a test project cannot be
             referenced from another, so the file is compiled here as well. -->
        <Compile Include="..\opencertserver.scep.server.tests\ScepTestClient.cs" Link="ScepTestClient.cs"/>
    </ItemGroup>

</Project>
