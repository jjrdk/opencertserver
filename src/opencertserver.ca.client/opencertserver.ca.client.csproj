<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RootNamespace>OpenCertServer.Ca.Client</RootNamespace>
        <AssemblyName>opencertserver.ca.client</AssemblyName>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Description>HTTP client for a backing certificate authority. Issues and revokes over a trusted
        HTTPS connection (mTLS or bearer) so an ACME server or a registration authority can be deployed
        as its own process without hosting the CA core in-process. Implements ICertificateAuthority for
        ACME revocation and exposes a SignCsr path for a remote ACME issuer. This project references only
        the shared protocol and the CA utils helpers, never the CA core.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Http"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
        <ProjectReference Include="..\opencertserver.ca.protocol\opencertserver.ca.protocol.csproj" />
        <ProjectReference Include="..\opencertserver.ca.utils\opencertserver.ca.utils.csproj"/>
    </ItemGroup>
</Project>
