<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <RootNamespace>OpenCertServer.Host.Ca</RootNamespace>
        <AssemblyName>opencertserver.host.ca</AssemblyName>
        <OutputType>Exe</OutputType>
        <TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
        <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
        <EFScaffoldModelStage>none</EFScaffoldModelStage>
        <EFPrecompileQueriesStage>none</EFPrecompileQueriesStage>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Description>A hardened certificate-authority appliance. It hosts the CA core and the CA-side
        RA bindings, plus relational (PostgreSQL/MSSQL) or in-memory storage selected at runtime. It is
        the trust anchor only: it serves the CA responder (/csr, /crl, /ocsp, /profiles) and never the
        EST enrollment, ACME, or SCEP endpoints. It references opencertserver.ca.server,
        opencertserver.ca.utils, opencertserver.est.server, and the data stores, but never
        opencertserver.acme.server or opencertserver.scep.server.</Description>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <NoWarn>1701;1702;IL2026</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <NoWarn>1701;1702;IL2026</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\opencertserver.ca.server\opencertserver.ca.server.csproj"/>
        <ProjectReference Include="..\..\opencertserver.ca.utils\opencertserver.ca.utils.csproj"/>
        <ProjectReference Include="..\..\opencertserver.est.server\opencertserver.est.server.csproj"/>
        <ProjectReference Include="..\..\opencertserver.data\opencertserver.data.csproj"/>
        <ProjectReference Include="..\..\opencertserver.data.postgresql\opencertserver.data.postgresql.csproj"/>
        <ProjectReference Include="..\..\opencertserver.data.mssql\opencertserver.data.mssql.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens"/>
        <PackageReference Include="Microsoft.IdentityModel.Protocols"/>
        <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect"/>
        <PackageReference Include="OpenTelemetry"/>
        <PackageReference Include="OpenTelemetry.Api.ProviderBuilderExtensions"/>
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol"/>
        <PackageReference Include="OpenTelemetry.Extensions.Hosting"/>
    </ItemGroup>

</Project>
