{
  "$schema": "https://json.schemastore.org/aspnetcore-10-0",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AcmeServer": {
    "Authority": "https://ca.example.com",
    "Audiences": [
      "https://acme.example.com"
    ],
    "Issuer": "remote"
  },
  "Ca": {
    "RemoteUrl": "https://ca.example.com/",
    "Profile": "rsa",
    "DelegatedScope": "example.com",
    "BearerToken": "",
    "Trust": "",
    "ClientCert": "",
    "ClientCertPassword": ""
  }
}
