{
    "Logging": {
        "LogLevel": {
            "Default": "Debug",
            "System": "Information",
            "Microsoft": "Information"
        }
    },
    "AllowedHosts": "localhost;127.0.0.1;[::1]",
    "ConnectionStrings": {
        "OpenCertServer": null
    },
    "AcmeServer": {
        "Persistence": "memory"
    },
    "Ca": {
        "Persistence": "memory"
    },
    "Cors": {
        "TrustedOrigins": [
            "http://localhost:3000",
            "https://www.yourdomain.com"
        ]
    }
}
