{
    "Appliance": {
        "Hardened": false,
        "Role": "Unified"
    },
    "Migration": {
        "AutoApply": false
    },
    "Logging": {
        "LogLevel": {
            "Default": "Debug",
            "System": "Information",
            "Microsoft": "Information"
        }
    },
    "AllowedHosts": "localhost;127.0.0.1;[::1]",
    "ConnectionStrings": {
        "OpenCertServer": null
    },
    "AcmeServer": {
        "Persistence": "memory"
    },
    "PublicRa": {
        "Enabled": false,
        "RateLimit": 60,
        "RequireEab": false,
        "RequireApproval": false,
        "Profiles": []
    },
    "Ca": {
        "Persistence": "memory",
        "AcceptRa": false,
        "RaBindings": []
    },
    "Scep": {
        "DynamicChallenge": {
            "Enabled": false,
            "Webhook": null,
            "Secret": null
        }
    },
    "Cors": {
        "TrustedOrigins": [
            "http://localhost:3000",
            "https://www.yourdomain.com"
        ]
    }
}
