{
  "Appliance": {
    "Hardened": true,
    "Role": "Unified",
    "DataDirectory": "/var/lib/opencertserver"
  },
  "Migration": {
    "AutoApply": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "OpenTelemetry": "Information"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "AcmeServer": {
    "ExternalAccountRequired": true,
    "DisableCaaChecks": false,
    "HostedWorkers": {
      "EnableValidationService": true,
      "EnableIssuanceService": true
    }
  },
  "CaServer": {
    "OCSP": [
      "http://localhost:6001/ocsp"
    ],
    "CrlDistributionPoints": [
      "http://localhost:6001/ca/{profile}/crl"
    ],
    "CaIssuers": [
      "http://localhost:6001/ca/ca.pem"
    ]
  },
  "rsa": {
    "KeyUsage": "DigitalSignature,KeyEncipherment",
    "ExtendedKeyUsages": [
      "1.3.6.1.5.5.7.3.1",
      "1.3.6.1.5.5.7.3.2"
    ],
    "CertificatePolicies": [
      "1.3.6.1.4.1.9999.1"
    ]
  },
  "Telemetry": {
    "Enabled": true,
    "OtlpEndpoint": "http://localhost:4317",
    "ServiceName": "opencertserver"
  }
}
