{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "AcmeProxy": {
    "Routes": {
      "route.alpha": {
        "Hosts": [ "alpha.example.com" ],
        "CommonName": "alpha.example.com",
        "Enabled": true
      },
      "route.beta": {
        "Hosts": [ "beta.example.com" ],
        "CommonName": "beta.example.com",
        "Enabled": true
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "route.alpha": {
        "ClusterId": "cluster.alpha",
        "Match": { "Hosts": [ "alpha.example.com" ] }
      },
      "route.beta": {
        "ClusterId": "cluster.beta",
        "Match": { "Hosts": [ "beta.example.com" ] }
      }
    },
    "Clusters": {
      "cluster.alpha": {
        "Destinations": { "alpha": { "Address": "http://localhost:5001" } }
      },
      "cluster.beta": {
        "Destinations": { "beta": { "Address": "http://localhost:5002" } }
      }
    }
  }
}
