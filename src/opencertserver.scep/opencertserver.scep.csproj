<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
    <NoWarn>$(NoWarn);1701;1702;IL2026</NoWarn>
    <AssemblyName>opencertserver.scep</AssemblyName>
    <RootNamespace>OpenCertServer.Scep</RootNamespace>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\opencertserver.scep.server\opencertserver.scep.server.csproj" />
    <ProjectReference Include="..\opencertserver.ca.client\opencertserver.ca.client.csproj" />
    <ProjectReference Include="..\opencertserver.contrib.intune\opencertserver.contrib.intune.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Certificate" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

</Project>
