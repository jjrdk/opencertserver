<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
        <RootNamespace>OpenCertServer.Build</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Cake.Frosting" />
        <PackageReference Include="Cake.Docker" />
        <PackageReference Include="NuGet.Packaging" />
        <PackageReference Include="NuGet.Protocol" />
        <!-- Cake.Frosting 6.3.0 brings System.Security.Cryptography.Pkcs 10.0.12, which carries
             GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx; NuGet audit fails the restore. A direct
             reference lifts it to the patched 10.0.13 until Cake moves. -->
        <PackageReference Include="System.Security.Cryptography.Pkcs" />
        <PackageReference Include="GitVersion.MsBuild">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
</Project>
